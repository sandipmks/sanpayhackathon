/**
 * CHAT MESSAGE UTILITIES
 */
function appendChatMessage(role, text) {
  const container = document.getElementById('ai-chat-messages');
  if (!container) return;

  const isUser = role === 'user';
  const div = document.createElement('div');
  div.className = `flex items-start space-x-3 ${isUser ? 'flex-row-reverse space-x-reverse' : ''}`;
  
  div.innerHTML = `
    <div class="w-8 h-8 rounded-xl ${isUser ? 'bg-slate-200 text-slate-800' : 'bg-emerald-100 text-emerald-800'} flex items-center justify-center text-xs flex-shrink-0">
      <i class="fa-solid ${isUser ? 'fa-user' : 'fa-leaf'}"></i>
    </div>
    <div class="${isUser ? 'bg-emerald-600 text-white font-medium' : 'bg-slate-50 border border-slate-200/80 text-slate-700'} rounded-2xl ${isUser ? 'rounded-tr-none' : 'rounded-tl-none'} p-3.5 text-xs max-w-[85%] leading-relaxed shadow-sm">
      ${text}
    </div>
  `;
  container.appendChild(div);
  container.scrollTop = container.scrollHeight;
}

function handleSendTextMessage(event) {
  event.preventDefault();
  const input = document.getElementById('ai-text-input');
  const text = input.value.trim();
  if (!text) return;
  input.value = '';
  processUserVoiceInput(text);
}

function clearChatHistory() {
  const container = document.getElementById('ai-chat-messages');
  container.innerHTML = '';
  appendChatMessage('assistant', 'Chat transcript cleared. How can I help evaluate your next purchase?');
}

/**
 * MODAL NAVIGATION & CONTROLS
 */
function openVoiceModal() {
  document.getElementById('voice-modal').classList.remove('hidden');
  document.getElementById('modal-speech-transcript').innerText = "(Tap orb and speak...)";
}

function closeVoiceModal() {
  document.getElementById('voice-modal').classList.add('hidden');
  if (speechRecognition && isRecognizing) speechRecognition.stop();
  if (speechSynth && speechSynth.speaking) speechSynth.cancel();
  updateVoiceUIState('idle');
}

function switchModalToTextFallback() {
  closeVoiceModal();
  navigateTo('ai');
  document.getElementById('ai-text-input').focus();
}

function viewGeneratedSimulationFromModal() {
  closeVoiceModal();
  navigateTo('simulator');
}

/**
 * REWARDS REDEMPTION & OFFSET SIMULATIONS
 */
function redeemReward(name, pts) {
  if (state.currentUser.greenPoints < pts) {
    showToast("Insufficient Green Points balance.");
    return;
  }
  state.currentUser.greenPoints -= pts;
  updatePointsBadges();
  showToast(`Successfully redeemed "${name}"!`);
}

function simulateOffset(project, cost) {
  state.currentUser.greenPoints += 50;
  state.transactions.unshift({
    id: 'TX-' + Math.floor(1000 + Math.random() * 9000),
    merchant: `Carbon Offset: ${project}`,
    category: 'utilities',
    amount: cost,
    carbon: -10.0,
    method: 'VCS Certified Peat/Mangrove Retirement',
    source: 'Indonesia Carbon Exchange (IDXCarbon)',
    points: 50,
    date: 'Just now'
  });
  renderDashboardTransactions();
  renderFullTransactions();
  updatePointsBadges();
  showToast(`Offset 10 kg CO2e via ${project}!`);
}

function updatePointsBadges() {
  const pts = state.currentUser.greenPoints.toLocaleString();
  document.getElementById('sidebar-green-points').innerText = pts;
  document.getElementById('dashboard-green-points').innerText = pts;
  document.getElementById('rewards-point-badge').innerText = pts;
}

/**
 * TOAST & DEMO HELPERS
 */
function showToast(msg) {
  const toast = document.getElementById('toast');
  const label = document.getElementById('toast-message');
  label.innerText = msg;
  toast.classList.remove('translate-y-20', 'opacity-0');
  setTimeout(() => {
    toast.classList.add('translate-y-20', 'opacity-0');
  }, 3500);
}

function toggleMobileMenu() {
  const sidebar = document.getElementById('sidebar');
  sidebar.classList.toggle('hidden');
}

function toggleNotification() {
  showToast("No new alerts. Your spending is 18.4% greener this month!");
}

/**
 * NAVIGATION ROUTER
 */
function navigateTo(viewId) {
  state.activeView = viewId;
  
  const views = ['dashboard', 'simulator', 'transactions', 'carbon', 'offset', 'greenmap', 'missions', 'rewards', 'ai', 'analytics', 'partner'];
  views.forEach(v => {
    const el = document.getElementById(`view-${v}`);
    if (el) el.classList.add('hidden');
    const navBtn = document.getElementById(`nav-${v}`);
    if (navBtn) {
      if (v === 'simulator') {
        navBtn.className = "nav-item w-full flex items-center space-x-3 px-3 py-2.5 rounded-xl text-sm font-medium text-slate-600 hover:text-emerald-700 hover:bg-slate-50 transition-all group";
      } else {
        navBtn.className = "nav-item w-full flex items-center space-x-3 px-3 py-2.5 rounded-xl text-sm font-medium text-slate-600 hover:text-emerald-700 hover:bg-slate-50 transition-all group";
      }
    }
  });

  const activeEl = document.getElementById(`view-${viewId}`);
  if (activeEl) activeEl.classList.remove('hidden');

  const activeBtn = document.getElementById(`nav-${viewId}`);
  if (activeBtn) {
    activeBtn.className = "nav-item w-full flex items-center space-x-3 px-3 py-2.5 rounded-xl text-sm font-semibold text-emerald-800 bg-emerald-50/80 border border-emerald-200/60 transition-all group";
  }

  const titles = {
    dashboard: 'Dashboard',
    simulator: 'Before You Spend — Simulator',
    transactions: 'Transactions',
    carbon: 'Carbon Analytics',
    offset: 'Offset & Invest',
    greenmap: 'Green Map',
    missions: 'Missions',
    rewards: 'Green Rewards',
    ai: 'SanPay Voice AI',
    analytics: 'Analytics',
    partner: 'Partner Network'
  };
  document.getElementById('page-title').innerText = titles[viewId] || 'SanPay Green FinOS';

  if (window.innerWidth < 768) {
    document.getElementById('sidebar').classList.add('hidden');
  }

  window.scrollTo({ top: 0, behavior: 'smooth' });
}
</script>
