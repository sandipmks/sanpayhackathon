  container.innerHTML = state.savedSimulations.slice(0, 3).map(s => `
    <div class="p-3.5 rounded-2xl bg-slate-50 border border-slate-200/80 hover:border-emerald-300 transition-colors flex items-center justify-between">
      <div class="space-y-0.5 max-w-[65%]">
        <div class="flex items-center space-x-2">
          <span class="text-[10px] font-bold uppercase tracking-wider text-emerald-800 bg-emerald-100 px-2 py-0.5 rounded border border-emerald-200">
            ${s.category.toUpperCase()}
          </span>
          <span class="text-[11px] text-slate-500">${s.timestamp}</span>
        </div>
        <h4 class="text-xs font-semibold text-slate-900 truncate">${s.desc}</h4>
        <p class="text-[11px] text-slate-500 truncate">Swap: <span class="text-emerald-700 font-medium">${s.altName}</span></p>
      </div>

      <div class="text-right">
        <span class="text-xs font-bold font-display text-emerald-600 block">-${s.carbonAvoided} kg CO2e</span>
        <span class="text-[10px] text-amber-600 font-bold">+${s.potentialPoints} pts</span>
      </div>
    </div>
  `).join('');
}

function renderDashboardTransactions() {
  const container = document.getElementById('dashboard-transactions-list');
  if (!container) return;

  container.innerHTML = state.transactions.slice(0, 4).map(tx => `
    <div class="p-3 rounded-2xl bg-slate-50 border border-slate-200/80 flex items-center justify-between">
      <div class="space-y-0.5">
        <h4 class="text-xs font-semibold text-slate-900 truncate max-w-[140px]">${tx.merchant}</h4>
        <span class="text-[10px] text-slate-500">${tx.date}</span>
      </div>
      <div class="text-right">
        <span class="text-xs font-semibold text-slate-900 block">Rp ${tx.amount.toLocaleString('id-ID')}</span>
        <span class="text-[10px] text-emerald-600 font-bold">${tx.carbon} kg CO2e</span>
      </div>
    </div>
  `).join('');
}

function renderFullTransactions(filter = 'all') {
  const body = document.getElementById('full-transactions-body');
  if (!body) return;

  const filtered = filter === 'all' 
    ? state.transactions 
    : state.transactions.filter(t => t.category === filter);

  body.innerHTML = filtered.map(tx => `
    <tr class="hover:bg-slate-50 transition-colors">
      <td class="px-5 py-3.5 font-semibold text-slate-900">${tx.merchant}</td>
      <td class="px-5 py-3.5"><span class="bg-slate-100 text-slate-700 px-2 py-0.5 rounded text-[10px] uppercase font-bold">${tx.category}</span></td>
      <td class="px-5 py-3.5 font-display font-semibold text-slate-900">Rp ${tx.amount.toLocaleString('id-ID')}</td>
      <td class="px-5 py-3.5 text-emerald-600 font-bold">${tx.carbon} kg CO2e</td>
      <td class="px-5 py-3.5 text-slate-500 text-[11px]">${tx.method} <br><span class="text-[9px] text-slate-400">${tx.source}</span></td>
      <td class="px-5 py-3.5 text-amber-600 font-bold">+${tx.points} pts</td>
      <td class="px-5 py-3.5 text-slate-500">${tx.date}</td>
    </tr>
  `).join('');
}

function filterTransactions() {
  const val = document.getElementById('tx-filter').value;
  renderFullTransactions(val);
}

