  }
}

function processUserVoiceInput(transcript) {
  updateVoiceUIState('processing');
  appendChatMessage('user', transcript);

  const lower = transcript.toLowerCase();
  let amount = 100000;
  let category = 'food';

  const amountMatch = lower.match(/(\d+[\d.,]*)\s*(ribu|k|jt|juta|rb)?/);
  if (amountMatch) {
    let rawNum = parseFloat(amountMatch[1].replace(/\./g, '').replace(/,/g, '.'));
    let multiplier = amountMatch[2];
    if (multiplier === 'ribu' || multiplier === 'rb' || multiplier === 'k') rawNum *= 1000;
    if (multiplier === 'juta' || multiplier === 'jt') rawNum *= 1000000;
    if (rawNum > 1000) amount = rawNum;
  }

  if (lower.includes('kopi') || lower.includes('coffee') || lower.includes('makan') || lower.includes('lunch') || lower.includes('dinner') || lower.includes('restoran')) {
    category = 'food';
  } else if (lower.includes('taksi') || lower.includes('grab') || lower.includes('gojek') || lower.includes('ride') || lower.includes('ojek')) {
    category = 'ride';
  } else if (lower.includes('kereta') || lower.includes('mrt') || lower.includes('bus') || lower.includes('trans')) {
    category = 'transport';
  } else if (lower.includes('baju') || lower.includes('sepatu') || lower.includes('mall') || lower.includes('belanja')) {
    category = 'retail';
  }

  const altPrice = Math.round(amount * 0.7);
  const result = CarbonEngine.calculateSimulation(category, amount, altPrice);

  state.currentSimulation = {
    id: 'sim-' + Date.now(),
    desc: transcript,
    category: category,
    origAmount: amount,
    altAmount: altPrice,
    origName: `Conventional ${category.toUpperCase()} Choice`,
    altName: CarbonEngine.factors[category].defaultAltName,
    origCarbon: result.origCarbon,
    altCarbon: result.altCarbon,
    carbonAvoided: result.carbonAvoided,
    carbonPct: result.carbonPct,
    moneySaved: result.moneySaved,
    potentialPoints: result.points,
    assumption: result.assumption,
    confidence: result.confidence,
    timestamp: 'Just now'
  };

  syncSimulationViewData();

  const isIndo = lower.includes('saya') || lower.includes('beli') || lower.includes('berapa') || lower.includes('mau');
  
  let responseText = "";
  if (isIndo) {
    responseText = `Berdasarkan SanPay Carbon Engine, estimasi pembelian Rp${amount.toLocaleString('id-ID')} ini menghasilkan ${result.origCarbon} kg CO2e. Jika kamu beralih ke alternatif ramah lingkungan (${state.currentSimulation.altName}), emisinya hanya ${result.altCarbon} kg CO2e — potensi pengurangan sebesar ${result.carbonAvoided} kg CO2e (${result.carbonPct}%). Kamu juga menghemat Rp${result.moneySaved.toLocaleString('id-ID')} dan mendapatkan estimasi ${result.points} Green Points!`;
  } else {
    responseText = `Based on the SanPay calculation engine, spending Rp${amount.toLocaleString('id-ID')} generates approx ${result.origCarbon} kg CO2e. Switching to a sustainable option (${state.currentSimulation.altName}) produces only ${result.altCarbon} kg CO2e—saving ${result.carbonAvoided} kg CO2e (${result.carbonPct}%). You also save Rp${result.moneySaved.toLocaleString('id-ID')} and earn ${result.points} Green Points!`;
  }

  setTimeout(() => {
    updateVoiceUIState('speaking');
    appendChatMessage('assistant', responseText);
    
    const replyBox = document.getElementById('modal-ai-reply-box');
    const replyText = document.getElementById('modal-ai-reply-text');
    const simCard = document.getElementById('modal-simulation-card');
    const simSummary = document.getElementById('modal-sim-summary');
    const simPts = document.getElementById('modal-sim-pts');

    if (replyBox && replyText) {
      replyBox.classList.remove('hidden');
      replyText.innerText = responseText;
      if (simCard) {
        simCard.classList.remove('hidden');
        simSummary.innerText = `Avoided: ${result.carbonAvoided} kg CO2e (${result.carbonPct}%)`;
        simPts.innerText = `+${result.points} pts`;
      }
    }

    speakAloud(responseText);
  }, 400);
}

function speakAloud(text) {
  if (state.audioMuted || !speechSynth) {
    updateVoiceUIState('idle');
    return;
  }
  if (speechSynth.speaking) speechSynth.cancel();

  const utterance = new SpeechSynthesisUtterance(text);
  utterance.lang = 'id-ID';
  utterance.rate = 1.05;
  utterance.pitch = 1.0;
  utterance.onend = () => updateVoiceUIState('idle');
  utterance.onerror = () => updateVoiceUIState('idle');
  speechSynth.speak(utterance);
}

function stopAssistantSpeech() {
  if (speechSynth && speechSynth.speaking) speechSynth.cancel();
  updateVoiceUIState('idle');
}

function toggleAudioMute() {
  state.audioMuted = !state.audioMuted;
  const btn = document.getElementById('mute-toggle-btn');
  if (state.audioMuted) {
    if (speechSynth.speaking) speechSynth.cancel();
    btn.innerHTML = `<i class="fa-solid fa-volume-xmark text-rose-600"></i> Voice Output: MUTED`;
    showToast("Voice playback muted");
