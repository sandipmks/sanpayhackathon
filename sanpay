/**
 * CARBON CALCULATION ENGINE & EMISSION FACTORS
 */
const CarbonEngine = {
  factors: {
    food: {
      convFactor: 0.0416, // kg CO2e per IDR 1,000 equivalent for high meat
      altFactor: 0.0124,  // kg CO2e per IDR 1,000 for plant-based / local
      defaultAltName: 'Plant-Based / Locally-Sourced Meal',
      unit: 'kg CO2e / IDR',
      source: 'BPS Indonesia Food Matrix 2024 & IPCC WG3',
      confidence: 'High (88%)'
    },
    ride: {
      convFactor: 0.0875,
      altFactor: 0.0125,
      defaultAltName: 'MRT Electric Rail / EV Fleet',
      unit: 'kg CO2e / IDR',
      source: 'Ministry of Energy & Mineral Resources RI 2024',
      confidence: 'High (92%)'
    },
    transport: {
      convFactor: 0.0450,
      altFactor: 0.0080,
      defaultAltName: 'Bus Rapid Transit (Electric TransJakarta)',
      unit: 'kg CO2e / IDR',
      source: 'DKI Transportation Agency 2024',
      confidence: 'High (95%)'
    },
    retail: {
      convFactor: 0.0270,
      altFactor: 0.0110,
      defaultAltName: 'Eco-certified Recycled Material Goods',
      unit: 'kg CO2e / IDR',
      source: 'Ministry of Industry RI Life-Cycle Assessment',
      confidence: 'Moderate (74%)'
    },
    utilities: {
      convFactor: 0.0650,
      altFactor: 0.0050,
      defaultAltName: 'PLN Renewable Energy Certificate (REC)',
      unit: 'kg CO2e / IDR',
      source: 'PLN RUPTL Clean Energy Transition',
      confidence: 'High (94%)'
    },
    travel: {
      convFactor: 0.0950,
      altFactor: 0.0350,
      defaultAltName: 'Eco-Certified Green Lodging & High-Speed Rail',
      unit: 'kg CO2e / IDR',
      source: 'ICAO Carbon Calculator & Kemenparekraf',
      confidence: 'Moderate (78%)'
    },
    lifestyle: {
      convFactor: 0.0300,
      altFactor: 0.0100,
      defaultAltName: 'Circular Reusable Service',
      unit: 'kg CO2e / IDR',
      source: 'Indonesian Circular Economy Benchmark',
      confidence: 'Moderate (70%)'
    }
  },

  calculateSimulation(category, amountIdr, customAltPrice = null) {
    const catData = this.factors[category] || this.factors.food;
    const baseAmount = Math.max(1000, Number(amountIdr) || 50000);
    const altAmount = customAltPrice !== null && customAltPrice !== '' ? Number(customAltPrice) : Math.round(baseAmount * 0.75);

    const origCarbon = Number(((baseAmount / 1000) * catData.convFactor).toFixed(2));
    const altCarbon = Number(((altAmount / 1000) * catData.altFactor).toFixed(2));
    const carbonAvoided = Number(Math.max(0, origCarbon - altCarbon).toFixed(2));
    const carbonPct = origCarbon > 0 ? Number(((carbonAvoided / origCarbon) * 100).toFixed(1)) : 0;
    const moneySaved = Math.max(0, baseAmount - altAmount);

    const points = Math.round(20 + (carbonAvoided * 20));

    return {
      origCarbon,
      altCarbon,
      carbonAvoided,
      carbonPct,
      moneySaved,
      points,
      assumption: `${catData.source} (Factor: ${catData.convFactor} vs ${catData.altFactor} ${catData.unit})`,
      confidence: catData.confidence
    };
  }
};

/**
 * SANPAY VOICE AI ASSISTANT (WEB SPEECH API)
