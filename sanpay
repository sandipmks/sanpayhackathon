  document.getElementById('merchant-address').innerText = m.address;
  document.getElementById('merchant-badge').innerText = m.badge;
  document.getElementById('merchant-reward').innerText = m.reward;
  document.getElementById('merchant-carbon').innerText = m.carbon;
  document.getElementById('merchant-cert').innerText = m.cert;
}

function launchSimFromMerchant() {
  const title = document.getElementById('merchant-title').innerText;
  navigateTo('simulator');
  document.getElementById('sim-desc').value = `Eco visit at ${title}`;
  document.getElementById('sim-baseline').value = `Standard single-use plastic package`;
  document.getElementById('sim-alternative').value = `Zero-waste refill verified at ${title}`;
  handleRunSimulation(new Event('submit'));
