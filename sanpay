let speechRecognition = null;
let speechSynth = window.speechSynthesis;
let isRecognizing = false;

function initSpeechRecognition() {
  const SpeechRecognition = window.SpeechRecognition || window.webkitSpeechRecognition;
  if (!SpeechRecognition) return null;

  const recognizer = new SpeechRecognition();
  recognizer.continuous = false;
  recognizer.interimResults = true;
  recognizer.lang = 'id-ID';

  recognizer.onstart = () => {
    isRecognizing = true;
    updateVoiceUIState('listening');
  };

  recognizer.onresult = (event) => {
    let transcript = '';
    for (let i = event.resultIndex; i < event.results.length; ++i) {
      transcript += event.results[i][0].transcript;
    }
    document.getElementById('modal-speech-transcript').innerText = `"${transcript}"`;
    if (event.results[0].isFinal) {
      processUserVoiceInput(transcript);
    }
  };

  recognizer.onerror = () => {
    isRecognizing = false;
    updateVoiceUIState('idle');
    showToast("Voice recognition stopped.");
  };

  recognizer.onend = () => {
    isRecognizing = false;
    if (state.voiceState === 'listening') updateVoiceUIState('idle');
  };

  return recognizer;
}

speechRecognition = initSpeechRecognition();

function toggleVoiceListening() {
  if (!speechRecognition) {
    showToast("Voice recognition not supported in browser. Use typing!");
    openVoiceModal();
    switchModalToTextFallback();
    return;
  }

  if (speechSynth && speechSynth.speaking) speechSynth.cancel();

  if (isRecognizing) {
    speechRecognition.stop();
    isRecognizing = false;
    updateVoiceUIState('idle');
  } else {
    try {
      speechRecognition.start();
    } catch (e) {
      speechRecognition.stop();
      setTimeout(() => speechRecognition.start(), 200);
    }
  }
}

